# Copy this file to .env.local for local development.

# Base URL of the FastAPI backend (see ../backend). Defaults to
# http://localhost:8000 in lib/api.ts if this is unset.
NEXT_PUBLIC_API_URL=http://localhost:8000

# When "true", the app always uses the local fixtures in lib/fixtures.ts
# instead of calling the backend at all. Useful for working on the UI before
# the backend is running. When unset/"false" (the default), the app still
# calls the real API first and only falls back to fixtures automatically if
# that request fails (e.g. backend not started yet) -- so the app is
# demonstrable either way.
NEXT_PUBLIC_USE_MOCKS=false
