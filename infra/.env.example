# Copy this file to infra/.env before running docker compose:
#   cp infra/.env.example infra/.env
#
# These are LOCAL DEVELOPMENT defaults only. Never reuse these values anywhere
# real - production credentials live in AWS Secrets Manager (see
# infra/terraform/modules/secrets), never in a checked-in .env file.

POSTGRES_DB=construction_intel
POSTGRES_USER=construction_intel
POSTGRES_PASSWORD=changeme_local_only
POSTGRES_PORT=5432

REDIS_PORT=6379
